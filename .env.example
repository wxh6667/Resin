RESIN_ADMIN_TOKEN=change-me-admin-token
# Set RESIN_PROXY_TOKEN= to disable proxy authentication.
RESIN_PROXY_TOKEN=change-me-proxy-token
RESIN_PORT=2260

# Verified-node backflow upload. Leave RESIN_VERIFIED_UPLOAD_URL empty to
# disable. When set, both URL and token are required; the token is sent as a
# Bearer header and must never be committed to the repository.
RESIN_VERIFIED_UPLOAD_URL=
RESIN_VERIFIED_UPLOAD_TOKEN=
RESIN_VERIFIED_UPLOAD_WINDOW=2h
RESIN_VERIFIED_UPLOAD_TIMEOUT=30s
